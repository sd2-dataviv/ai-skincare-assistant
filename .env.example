# Settings for docker-compose.yml (WorkflowHub upload or `docker compose up`). Copy to .env and fill in.
# .env is read by the api service (env_file) and is never baked into an image.
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
POSTGRES_PASSWORD=skincare-demo-db

# AI "brain": groq | openai | ollama | scripted. No key = the scripted assistant answers.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

OTP_MODE=mock                 # mock accepts the fixed code 123456 (refused in production)
PHOTO_FACE_CHECK=true
SEED_DEMO_USERS=1             # 1 = demo staff accounts (password DEMO_PASSWORD); 0 = none
DEMO_PASSWORD=Demo@12345
CLINIC_TIMEZONE=Asia/Kolkata
PUBLIC_BASE_URL=              # empty = summary links are relative to wherever the app is served

# The clinic's skin models through the model gateway (docs/07-skin-models.md). WorkflowHub runs on the same network
# as the gateway (192.168.0.84), so these work there.
# ANALYSIS_ENGINE=ws
# SKIN_DIAGNOSIS_WS_URL=ws://192.168.0.84:5007/ws/models/187/ws/cv/1001/image/image?token=&notify=1
# SKIN_POST_TREATMENT_WS_URL=ws://192.168.0.84:5007/ws/models/167/ws/cv/1001/image/image?token=&notify=1
# Gateway token: a platform service account (recommended), or leave empty and the platform session of the last staff
# member who opened the app from WorkflowHub is used (docs/08-platform-sso.md).
# SKIN_MODEL_AUTH_EMAIL=
# SKIN_MODEL_AUTH_PASSWORD=

# The talking avatar (docs/09-avatar.md): the AI Avatar service says the assistant's replies (Direct mode). It signs in
# with the service account above. Empty = the browser's own voice.
# AVATAR_WS_URL=wss://avatar.instaviv.in
# AVATAR_ID=14                # 14 Meera, 10 Raghav, 18 Vedant Sir

# Platform sign-in. WorkflowHub injects WFH_AUTH_SERVICE_URL itself; set it here only for local runs.
# WFH_DEFAULT_ROLE=operator   # role for platform users without a clinic account (default operator); empty = refuse
