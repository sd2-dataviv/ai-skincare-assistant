# Copy to backend/.env and adjust. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://skincare:skincare@127.0.0.1:5433/skincare
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# LLM "brain": groq (default) | openai | ollama | scripted. Without an API key it falls back to scripted.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low   # low | medium | high (gpt-oss only)
# LLM_BASE_URL=http://localhost:11434/v1   # for Ollama

# Adapters: mock until real endpoints are available
ANALYSIS_ENGINE=mock
# ANALYSIS_ENGINE_URL=http://analysis-service/analyse
D365_MODE=mock
OTP_MODE=mock          # mock accepts the fixed code 123456 (refused in production)
MESSAGING_MODE=mock
STORAGE_DIR=./var/photos
PUBLIC_BASE_URL=http://localhost:5173

# Clinical policy (needs sign-off, see docs/01 §6)
ESCALATION_MIN_CONFIDENCE=0.6
CLIENT_SEES_DRAFT_PLAN=true
PHOTO_FACE_CHECK=true
