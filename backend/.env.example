# Copy to backend/.env and adjust. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://skincare:skincare@127.0.0.1:5433/skincare
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# LLM "brain": groq (default) | openai | ollama | scripted. Without an API key it falls back to scripted.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low   # low | medium | high (gpt-oss only)
# LLM_BASE_URL=http://localhost:11434/v1   # for Ollama

# Adapters: mock until real endpoints are available
ANALYSIS_ENGINE=mock   # mock | http | ws (the clinic's skin models, see docs/07-skin-models.md)
# ANALYSIS_ENGINE_URL=http://analysis-service/analyse
# SKIN_DIAGNOSIS_WS_URL=ws://192.168.0.84:9601/ws/cv/9819628774/image/image
# SKIN_POST_TREATMENT_WS_URL=ws://192.168.0.84:9600/ws/cv/3271585349/image/image
# Or through the model gateway; the app keeps a platform token renewed for it (docs/08-platform-sso.md):
# SKIN_DIAGNOSIS_WS_URL=ws://192.168.0.84:5007/ws/models/187/ws/cv/1001/image/image?token=&notify=1
# SKIN_POST_TREATMENT_WS_URL=ws://192.168.0.84:5007/ws/models/167/ws/cv/1001/image/image?token=&notify=1
# SKIN_MODEL_AUTH_EMAIL=        # platform service account (recommended); without it, the session of the last
# SKIN_MODEL_AUTH_PASSWORD=     #   staff member who opened the app from WorkflowHub is used
# SKIN_MODEL_TOKEN=             # a fixed token, quick checks only (expires after 15 minutes)

# WorkflowHub platform SSO (docs/08-platform-sso.md); WorkflowHub injects WFH_AUTH_SERVICE_URL
# WFH_AUTH_SERVICE_URL=http://192.168.0.84:5001/api
# WFH_AUTH_MODE=platform        # none = off
# WFH_DEFAULT_ROLE=operator     # role for platform users without a clinic account (default operator); empty = refuse
D365_MODE=mock
OTP_MODE=mock          # mock accepts the fixed code 123456 (refused in production)
MESSAGING_MODE=mock
STORAGE_DIR=./var/photos
PUBLIC_BASE_URL=http://localhost:5173

# Clinical policy (needs sign-off, see docs/01 §6)
ESCALATION_MIN_CONFIDENCE=0.6
CLIENT_SEES_DRAFT_PLAN=true
PHOTO_FACE_CHECK=true
